# Copy to .env (never commit it).   cp .env.example .env
# Generate a strong database password:   openssl rand -base64 24 | tr -d '/+=' 
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# The internal DNS name students will type (create this record on your DNS/router)
PORTAL_HOST=grades.school.lan

# Instructor password recovery (generic SMTP; leave blank on a local preview to disable email)
# Public URL of the portal (scheme + host students/instructors use), no trailing slash
PORTAL_BASE_URL=https://grades.school.lan
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Grade Portal <no-reply@grades.school.lan>"

# SMS is provision-ready but disabled. Leave SMS_GATEWAY empty until a provider is approved.
# When ready, set SMS_GATEWAY=custom and SMS_GATEWAY_MODULE to a module exporting a factory
# that returns an async send(to, message) function. Recovery remains email-only by design.
SMS_GATEWAY=
